{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://driftwall.app/schemas/dwpkg.manifest.schema.json",
  "title": "Driftwall .dwpkg package manifest",
  "description": "Canonical manifest describing a Driftwall wallpaper package (.dwpkg). Mirrors app/lib domain types; shared by app and backend.",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifestVersion", "id", "title", "type", "files", "createdAt"],
  "properties": {
    "manifestVersion": {
      "const": 1,
      "description": "Manifest schema version."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-5][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
      "description": "UUID v1-5 identifying the wallpaper."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "type": {
      "enum": ["static", "video"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "uniqueItems": true,
      "default": []
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/file" }
    },
    "loop": {
      "$ref": "#/definitions/loop"
    },
    "displays": {
      "type": "array",
      "items": { "$ref": "#/definitions/display" }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 creation timestamp."
    },
    "author": {
      "type": "string",
      "maxLength": 200
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "const": "video" } },
        "required": ["type"]
      },
      "then": {
        "required": ["files"]
      },
      "else": {
        "properties": { "loop": false }
      }
    }
  ],
  "definitions": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "bytes", "sha256"],
      "properties": {
        "role": { "enum": ["source", "thumbnail"] },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*\\.\\.).+$",
          "description": "Relative POSIX path inside the package; no absolute paths or '..'."
        },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex SHA-256 digest."
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 },
        "muted": { "type": "boolean", "default": true }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaleMode"],
      "properties": {
        "displayId": { "type": ["string", "null"] },
        "scaleMode": { "enum": ["fill", "fit", "stretch", "center"] },
        "anchor": {
          "enum": [
            "center",
            "top-left",
            "top-right",
            "bottom-left",
            "bottom-right"
          ]
        }
      }
    }
  }
}
